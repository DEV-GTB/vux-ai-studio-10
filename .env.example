# Copy this file to .env and fill in your own values locally.
# Do not commit .env with real secrets or keys.

# --- Gemini AI ---
# Create a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-31b-it

# --- DeepSeek coding assistant ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash

# --- Tripo 3D generation ---
TRIPO_API_KEY=your_tripo_api_key_here
TRIPO_MODEL=tripo-v3.1

# --- Hugging Face ---
# Create a Hugging Face API key at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_api_key_here
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-Krea-dev
HF_CHAT_MODEL=google/gemma-4-12B-it
HF_DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3.2
HF_VISION_MODEL=google/gemma-4-12B-it
HF_VISION_FALLBACK_MODEL=Qwen/Qwen2.5-VL-7B-Instruct:featherless-ai
THREE_STUDIO_URL=http://localhost:7860
TRELLIS_ENDPOINT=https://your-trellis-endpoint

# --- Together AI ---
# Create a Together AI API key at https://api.together.xyz/
TOGETHER_API_KEY=your_together_api_key_here

# --- Mistral AI ---
# Create a Mistral API key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# --- Security ---
ALLOWED_ORIGIN=
APP_ACCESS_CODE=replace_with_a_private_dashboard_code
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=40

# --- NEXUS cloud telemetry (server-side only) ---
NEXUS_DEVICE_ID=NEXUS-001
NEXUS_DEVICE_TOKEN=replace_with_a_random_device_token

# --- ESP32 local bridge (only reachable when this server is on the device LAN) ---
ESP32_BASE_URL=http://192.168.4.1
ESP32_STATE_PATH=/api/telemetry
ESP32_DIAG_PATH=/api/diag

PORT=3000